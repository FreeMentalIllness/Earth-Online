    <color name="widget_text_sub">#A9A196</color>
    <color name="widget_accent">#D4A373</color>
    <color name="widget_stroke">#3A3630</color>
    <color name="widget_track">#3A3630</color>
    <color name="widget_entry_bg">#2C2925</color>
</resources>
