<resources>
    <!-- 深色模式：状态栏图标转浅色（对应 HTML [data-theme="dark"] 仅覆盖 CSS 变量） -->
    <style name="Theme.EarthOnline" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 深色模式：窗口背景同步深色，避免「系统启动窗口(深) → Compose 首帧」之间的亮色闪帧；
             值与 SplashOverlay 深色变体（#1A1A1A）同源，三段接力依旧同色。 -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.EarthOnline.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.EarthOnline</item>
    </style>
</resources>
